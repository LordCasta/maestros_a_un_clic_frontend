# Copia este archivo como .env y ajusta los valores a tu entorno local.

# API del backend, incluida la versión.
VITE_API_BASE_URL=http://127.0.0.1:8000/api/v1

# Tiempo real (Laravel Reverb). Deben coincidir con REVERB_* del .env del backend.
VITE_REVERB_APP_KEY=maestros-local-key
VITE_REVERB_HOST=localhost
VITE_REVERB_PORT=8080
VITE_REVERB_SCHEME=http
